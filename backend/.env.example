# Ustawienia backendu. Wzór pliku .env (kopia: copy .env.example .env, plik .env nie trafia do repo).
# Plik .env jest wczytywany tylko z flagą --env-file: uvicorn src.main:app --reload --port 8000 --env-file .env

# Adresy frontendu, które mogą wywoływać API (kilka oddzielonych przecinkami). 5173 = serwer Vite.
CLIENT_ORIGIN=http://localhost:5173
